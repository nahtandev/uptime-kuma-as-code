{
  "defaults": {
    "type": "http",
    "method": "GET",
    "interval": 30,
    "retryInterval": 20,
    "maxretries": 1,
    "timeout": 24,
    "resendInterval": 0,
    "accepted_statuscodes": [
      "200-299"
    ],
    "maxredirects": 10,
    "ignoreTls": false,
    "upsideDown": false,
    "expiryNotification": true,
    "saveErrorResponse": true,
    "responseMaxLength": 1024,
    "active": true
  },
  "environments": {
    "production": {
      "notification": "discord-prod"
    },
    "staging": {
      "notification": "discord-staging",
      "overrides": {
        "interval": 120,
        "retryInterval": 60,
        "maxretries": 2,
        "timeout": 96
      }
    },
    "dev": {
      "notification": "discord-staging",
      "overrides": {
        "interval": 300,
        "retryInterval": 120,
        "maxretries": 3,
        "timeout": 240
      }
    }
  },
  "notifications": [
    {
      "key": "discord-prod",
      "name": "Discord Production",
      "type": "discord",
      "webhookEnv": "DISCORD_WEBHOOK_PROD",
      "mentionsEnv": "DISCORD_MENTION_IDS"
    },
    {
      "key": "discord-staging",
      "name": "Discord Staging",
      "type": "discord",
      "webhookEnv": "DISCORD_WEBHOOK_STAGING"
    }
  ],
