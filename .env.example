# Instance URL, no trailing slash
UPTIME_KUMA_URL=http://localhost:3001

# Kuma's configuration API only accepts a real login, not an API key
# (API keys only unlock /metrics). `npm run setup` creates this account on a
# fresh instance.
UPTIME_KUMA_USERNAME=admin
UPTIME_KUMA_PASSWORD=

# 6-digit code, only if 2FA is enabled on the account. It expires after 30 s:
# fill it right before running a command.
UPTIME_KUMA_TOTP=

# Discord webhooks, one channel per severity. Referenced by name in monitors.json.
DISCORD_WEBHOOK_PROD=
DISCORD_WEBHOOK_STAGING=

# Discord user IDs pinged on production alerts, comma-separated.
# Prefix a role ID with & (e.g. &123456789).
DISCORD_MENTION_IDS=

# Optional
# MONITORS_FILE=monitors.example.json
# KUMA_DB_PASSWORD=change-me
